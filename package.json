{
  "name": "cpa-landing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "vite",
    "start host": "vite --host",
    "start:ru": "vite --mode ru",
    "start:ua": "vite --mode ua",
    "build": "vite build && vite build --mode ru",
    "build:source": "vite build",
    "watch": "vite build --watch",
    "typecheck": "ngc --project tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "^22.2.2",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.10",
    "sass": "^1.93.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
